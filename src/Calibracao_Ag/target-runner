#!/usr/bin/env bash

# irace passes the configuration ID, instance ID, seed, instance and parameter switches.
seed=$3
instance=$4
shift 4

cd "$(dirname "$0")/.." || exit 1
executable=./exec_irace_ag
if [[ -f ./exec_irace_ag.exe ]]; then
    executable=./exec_irace_ag.exe
fi

exec "$executable" --instance "$instance" --seed "$seed" --metodo 12 "$@"
